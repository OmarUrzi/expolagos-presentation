{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expolagos-gallery",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "presentacion-eventos-expolagos"
    }
  ]
}
